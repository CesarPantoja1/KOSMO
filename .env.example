# Configuración general y entorno
ENV=development
LOG_LEVEL=DEBUG

# Puertos expuestos en el host
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Base de datos PostgreSQL
POSTGRES_USER=kosmo
POSTGRES_PASSWORD=kosmo
POSTGRES_DB=kosmo_dev

# Seguridad y autenticación
RUN_MIGRATIONS=1
DEV_GENERATE_SECRETS=1
FERNET_MASTER_KEY=
JWT_ISSUER=kosmo
JWT_AUDIENCE=kosmo-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Integración con GitHub (OAuth App)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GITHUB_SCOPES=repo

# Integración con Railway (OAuth App)
RAILWAY_CLIENT_ID=
RAILWAY_CLIENT_SECRET=
NEXT_PUBLIC_RAILWAY_CLIENT_ID=
NEXT_PUBLIC_RAILWAY_SCOPES=openid email profile offline_access workspace:admin

# Configuración de LLM del sistema
# Opciones: noop, openai, anthropic, gemini, deepseek
LLM_PROVIDER=noop
LLM_MODEL=noop
LLM_API_KEY=

# Claves de proveedores para OpenCode y agentes
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Generación de código (OpenCode)
OPENCODE_SERVER_PASSWORD=
OPENCODE_MODEL=deepseek/deepseek-v4-flash

# Previews y ejecución remota
CODE_RUNNER_TOKEN=
PREVIEW_PUBLIC_HOST_SUFFIX=
CLOUDFLARE_PREVIEW_API_TOKEN=
CLOUDFLARE_PREVIEW_ACCOUNT_ID=
CLOUDFLARE_PREVIEW_ZONE_ID=
CLOUDFLARE_PREVIEW_TUNNEL_ID=

# Variables del Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DOMAIN_APP=http://localhost:3000
NEXT_PUBLIC_APP_NAME=KOSMO
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_AUTH_DISABLED=false

# API, CORS y observabilidad
API_VERSION=v1
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOGFIRE_TOKEN=
OTEL_SERVICE_NAME=kosmo-backend
OTEL_ENVIRONMENT=development
