# ==============================================================================
# KOSMO - Docker Compose / Full-Stack Environment Variables Example
# ==============================================================================
# Copia este archivo a `.env` en la raíz del proyecto para desarrollo local:
#   cp .env.example .env
# Luego inicia todos los servicios con:
#   docker compose up -d
# ==============================================================================

# Entorno general y nivel de logs
ENV=development
LOG_LEVEL=DEBUG

# Puertos de servicios expuestos en el host
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Base de Datos PostgreSQL (con soporte pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=kosmo
POSTGRES_PASSWORD=kosmo
POSTGRES_DB=kosmo_dev

# ------------------------------------------------------------------------------
# Seguridad y Autenticación
# ------------------------------------------------------------------------------
# 1 = Ejecuta migraciones y genera certificados JWT en /tmp/kosmo-secrets si no existen
RUN_MIGRATIONS=1
DEV_GENERATE_SECRETS=1

# Clave maestra Fernet para cifrar secretos (tokens OAuth de GitHub, API keys de IA)
# Generar una con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_MASTER_KEY=

JWT_ISSUER=kosmo
JWT_AUDIENCE=kosmo-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ------------------------------------------------------------------------------
# Integración con GitHub (OAuth App)
# ------------------------------------------------------------------------------
# Crea tu aplicación en: https://github.com/settings/developers (OAuth Apps -> New OAuth App)
# - Application name: KOSMO Local Dev
# - Homepage URL: http://localhost:3000
# - Authorization callback URL: http://localhost:3000/perfil?tab=cuenta
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# ------------------------------------------------------------------------------
# Proveedor LLM por Defecto del Sistema
# ------------------------------------------------------------------------------
# Opciones: noop, openai, anthropic, gemini, deepseek
LLM_PROVIDER=noop
LLM_MODEL=noop
LLM_API_KEY=

# Claves de proveedores para OpenCode / Agentes autónomos
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Generación de Código (OpenCode Interpreter)
# ------------------------------------------------------------------------------
OPENCODE_SERVER_PASSWORD=kosmo-dev-password
OPENCODE_MODEL=deepseek/deepseek-v4-flash

# Previews públicas mediante Cloudflare Tunnel (opcional, mantener vacío en local)
CODE_RUNNER_TOKEN=
PREVIEW_PUBLIC_HOST_SUFFIX=
CLOUDFLARE_PREVIEW_API_TOKEN=
CLOUDFLARE_PREVIEW_ACCOUNT_ID=
CLOUDFLARE_PREVIEW_ZONE_ID=
CLOUDFLARE_PREVIEW_TUNNEL_ID=

# ------------------------------------------------------------------------------
# Variables Públicas del Frontend (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DOMAIN_APP=http://localhost:3000
NEXT_PUBLIC_APP_NAME=KOSMO
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_AUTH_DISABLED=false

# ------------------------------------------------------------------------------
# API, CORS y Observabilidad
# ------------------------------------------------------------------------------
API_VERSION=v1
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOGFIRE_TOKEN=
OTEL_SERVICE_NAME=kosmo-backend
OTEL_ENVIRONMENT=development
