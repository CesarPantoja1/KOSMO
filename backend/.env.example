# ==============================================================================
# KOSMO - Backend Environment Variables Example
# ==============================================================================
# Copia este archivo a `.env` en la carpeta backend para desarrollo local:
#   cp .env.example .env
# ==============================================================================

# Entorno de ejecución y nivel de logging
ENV=development
LOG_LEVEL=DEBUG

# ------------------------------------------------------------------------------
# Base de Datos y Cache
# ------------------------------------------------------------------------------
# PostgreSQL con driver asyncpg (soporta pgvector)
DATABASE_URL=postgresql+asyncpg://kosmo:kosmo@localhost:5432/kosmo_dev

# Redis para sesiones, refresh tokens y rate limiting
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Seguridad y Criptografía
# ------------------------------------------------------------------------------
# Clave maestra Fernet para cifrar secretos de usuarios (tokens OAuth, API keys de IA)
# Generar una con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_MASTER_KEY=qn9GZmTM--RH5MVh3kLmyS-oeHYCmnYCVPW9BRFLuik=

# Claves RSA para firma y verificación de JWT (RS256)
# En desarrollo local: rutas relativas a archivos PEM
JWT_PRIVATE_KEY_PATH=./.secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./.secrets/jwt_public.pem
# En producción/CI: puedes usar el contenido directo en una sola línea o PEM
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=

# Configuración de JWT
JWT_ALGORITHM=RS256
JWT_ISSUER=kosmo
JWT_AUDIENCE=kosmo-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Parámetros de hashing Argon2id (OWASP 2025)
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Auth bypass (solo para desarrollo local — desactiva la verificación JWT)
AUTH_DISABLED=false

# ------------------------------------------------------------------------------
# Integración con GitHub (OAuth App)
# ------------------------------------------------------------------------------
# Crear en GitHub: Settings -> Developer settings -> OAuth Apps -> New OAuth App
# - Application name: KOSMO Local Dev
# - Homepage URL: http://localhost:3000
# - Authorization callback URL: http://localhost:3000/perfil?tab=cuenta
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Proveedor LLM por Defecto del Sistema (BYOK / Fallback)
# ------------------------------------------------------------------------------
# Opciones de proveedor: noop, openai, anthropic, gemini, deepseek
LLM_PROVIDER=noop
LLM_MODEL=noop
LLM_API_KEY=

# Proveedor de Embeddings (auto, openai, fastembed, none)
EMBEDDING_PROVIDER=auto

# ------------------------------------------------------------------------------
# Generación de Código y Workspace (OpenCode & Sandboxes)
# ------------------------------------------------------------------------------
# URL del servidor OpenCode
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=kosmo-dev-password
OPENCODE_MODEL=deepseek/deepseek-v4-flash

# Directorio local donde se generan los workspaces y proyectos de código
KOSMO_WORKSPACES_DIR=./workspaces
KOSMO_MCP_BASE_URL=http://127.0.0.1:8000/mcp

# Code Runner remoto (opcional, en local se usa ejecución de subprocesos / Docker)
CODE_RUNNER_BASE_URL=
CODE_RUNNER_TOKEN=

# Cloudflare Tunnel para previews públicas (opcional, mantener vacío en desarrollo local)
PREVIEW_PUBLIC_HOST_SUFFIX=
CLOUDFLARE_PREVIEW_API_TOKEN=
CLOUDFLARE_PREVIEW_ACCOUNT_ID=
CLOUDFLARE_PREVIEW_ZONE_ID=
CLOUDFLARE_PREVIEW_TUNNEL_ID=

# ------------------------------------------------------------------------------
# Configuración de la API HTTP y CORS
# ------------------------------------------------------------------------------
API_VERSION=v1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# Observabilidad y Telemetría
# ------------------------------------------------------------------------------
LOGFIRE_TOKEN=
OTEL_SERVICE_NAME=kosmo-backend
OTEL_ENVIRONMENT=development