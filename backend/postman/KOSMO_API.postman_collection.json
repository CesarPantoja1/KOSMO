						}
					}
				},
				{
					"name": "GET - Obtener diagrama existente",
					"event": [],
					"request": {
						"method": "GET",
						"url": { "raw": "{{base_url}}/api/v1/features/{{feature_id}}/diagram?project_id={{project_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "features", "{{feature_id}}", "diagram"], "query": [{ "key": "project_id", "value": "{{project_id}}" }] }
					}
				}
			]
		},
		{
			"name": "Plan",
			"item": [
				{
					"name": "GET State - Obtener estado del plan de cambios",
					"event": [],
					"request": {
						"method": "GET",
						"url": { "raw": "{{base_url}}/api/v1/projects/{{project_id}}/plan?phase=descubrimiento", "host": ["{{base_url}}"], "path": ["api", "v1", "projects", "{{project_id}}", "plan"], "query": [{ "key": "phase", "value": "descubrimiento" }] }
					}
				},
				{
					"name": "POST Changes - Agregar cambio al plan",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.changes && jsonData.changes.length > 0) {",
									"        pm.collectionVariables.set('change_id', jsonData.changes[0].id);",
									"        console.log('Change ID guardado: ' + jsonData.changes[0].id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"url": { "raw": "{{base_url}}/api/v1/projects/{{project_id}}/plan/changes?phase=descubrimiento", "host": ["{{base_url}}"], "path": ["api", "v1", "projects", "{{project_id}}", "plan", "changes"], "query": [{ "key": "phase", "value": "descubrimiento" }] },
						"body": {
							"mode": "raw",
							"raw": "{\n  \"change_id\": \"chg_01HXYAZABCDEFGHIJKLMNOP\",\n  \"section\": \"Propuesta de Valor\",\n  \"description\": \"Ampliar alcance a mercado latinoamericano\",\n  \"diff_before\": \"## Propuesta de Valor\\n\\nAyudamos a dueños de lavanderias en Argentina...\",\n  \"diff_after\": \"## Propuesta de Valor\\n\\nAyudamos a dueños de lavanderias en toda Latinoamerica...\",\n  \"rationale\": \"El mercado latinoamericano comparte problemas similares de gestion de lavanderias\"\n}",
							"options": { "raw": { "language": "json" } }
						}
					}
				},
