					"event": [],
					"request": {
						"method": "DELETE",
						"url": { "raw": "{{base_url}}/api/v1/projects/{{project_id}}/plan/changes/{{change_id}}?phase=descubrimiento", "host": ["{{base_url}}"], "path": ["api", "v1", "projects", "{{project_id}}", "plan", "changes", "{{change_id}}"], "query": [{ "key": "phase", "value": "descubrimiento" }] }
					}
				},
				{
					"name": "POST Apply - Aplicar lote de cambios",
					"event": [],
					"request": {
						"method": "POST",
						"url": { "raw": "{{base_url}}/api/v1/projects/{{project_id}}/plan/apply", "host": ["{{base_url}}"], "path": ["api", "v1", "projects", "{{project_id}}", "plan", "apply"] },
						"body": {
