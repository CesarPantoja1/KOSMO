							"mode": "raw",
							"raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"markdown\": \"### REQ-1.1 Titulo del requisito\\n\\n**Ubicuo**\\n\\nEl sistema debe presentar todos los montos con exactamente dos decimales.\\n\\n**Criterios de Aceptacion**\\n\\n**Escenario: Montos en pantalla de balance**\\n\\n- **Dado** que el usuario se encuentra en la pantalla principal\\n- **Cuando** hace clic en la pestana Balance\\n- **Entonces** todos los montos aparecen formateados con dos decimales\"\n}",
							"options": { "raw": { "language": "json" } }
						}
					}
				},
				{
					"name": "POST Refine - Refinar requisitos EARS con IA",
					"event": [],
					"request": {
						"method": "POST",
						"url": { "raw": "{{base_url}}/api/v1/features/{{feature_id}}/requirements/refine", "host": ["{{base_url}}"], "path": ["api", "v1", "features", "{{feature_id}}", "requirements", "refine"] },
						"body": {
							"mode": "raw",
							"raw": "{\n  \"project_id\": \"{{project_id}}\",\n  \"instructions\": \"Agrega criterios de aceptacion para timeout de red y caso de error en cada requisito\"\n}",
							"options": { "raw": { "language": "json" } }
						}
					}
				}
			]
		},
