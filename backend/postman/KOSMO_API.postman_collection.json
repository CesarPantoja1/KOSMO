					"name": "POST Generate - Generar diagrama de actividad con IA",
					"event": [],
					"request": {
						"method": "POST",
						"url": { "raw": "{{base_url}}/api/v1/features/{{feature_id}}/diagram/generate", "host": ["{{base_url}}"], "path": ["api", "v1", "features", "{{feature_id}}", "diagram", "generate"] },
						"body": {
