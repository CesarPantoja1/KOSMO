# ==============================================================================
# KOSMO - Frontend Environment Variables Example
# ==============================================================================
# Copia este archivo a `.env.local` para desarrollo local en la carpeta frontend:
#   cp .env.example .env.local
# ==============================================================================

# URL base del Backend FastAPI
# En desarrollo local: http://localhost:8000
# En producción/Vercel: https://api.tudominio.com (o vacío si usas proxy reverso Nginx)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Nombre y entorno de la aplicación
NEXT_PUBLIC_APP_NAME=KOSMO
NEXT_PUBLIC_APP_ENV=development

# Dominio público del frontend (usado para callbacks y redirecciones)
NEXT_PUBLIC_DOMAIN_APP=http://localhost:3000

# Bypass de autenticación para desarrollo rápido (true/false)
NEXT_PUBLIC_AUTH_DISABLED=false

# Mocks para pruebas aisladas de UI sin backend (true/false)
NEXT_PUBLIC_USE_MOCKS=false

# ------------------------------------------------------------------------------
# Integración con GitHub (OAuth App)
# ------------------------------------------------------------------------------
# Client ID de tu GitHub OAuth App (Settings -> Developer settings -> OAuth Apps)
# Nota: La Authorization callback URL en GitHub debe ser:
#   http://localhost:3000/perfil?tab=cuenta
NEXT_PUBLIC_GITHUB_CLIENT_ID=

# ------------------------------------------------------------------------------
# Integración con Railway (Opcional para despliegues)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAILWAY_CLIENT_ID=

