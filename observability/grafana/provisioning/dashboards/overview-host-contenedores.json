{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Uso de CPU del Host (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU Host"
        }
      ]
    },
    {
      "title": "Uso de Memoria RAM del Host (GB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / 1024 / 1024 / 1024",
          "legendFormat": "RAM Usada (GB)"
        }
      ]
    },
    {
      "title": "Uso de RAM por Contenedor (MB)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "label_replace(label_replace(container_memory_working_set_bytes{id=~\".*docker.*\"} / 1024 / 1024, \"nombre\", \"$1\", \"id\", \".*/system.slice:(.*)\"), \"nombre\", \"Contenedor Docker ($1)\", \"nombre\", \"system.slice:docker:(.*)\")",
          "legendFormat": "{{nombre}}"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["kosmo", "infraestructura"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "Overview de Host y Contenedores",
  "uid": "kosmo-overview-host"
}
